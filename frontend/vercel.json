{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "experimentalServices": {
        "frontend": {
          "root": "frontend",
          "routePrefix": "/",
          "framework": "vite"
        },
        "backend": {
          "root": "backend",
          "routePrefix": "/_/backend"
        }
      }
    }
  ]
}